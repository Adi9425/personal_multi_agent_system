TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MODE=polling           # polling | webhook

# comma-separated Telegram numeric user_ids (never usernames — see services/users.py) that
# get permanent, unrestricted access bypassing trial/rate limits entirely. Never commit
# real values — this repo is public.
ADMIN_TELEGRAM_USER_IDS=

DATABASE_URL=postgresql+asyncpg://notes:notes@localhost:5432/notes
REDIS_URL=redis://localhost:6379

USER_TIMEZONE=Asia/Kolkata

# Test aid only — sleeps before the echo send so the worker can be killed mid-job
# on purpose to verify queue durability. Leave at 0 for normal operation.
WORKER_TEST_DELAY_SECONDS=0

TRIAL_DAYS=14
TRIAL_REQUEST_LIMIT=50
RATE_LIMIT_MAX_PER_MINUTE=10

ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_STRONG=claude-sonnet-5

VOYAGE_API_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
